;; replace.glon -- REBOL Cookbook recipe 0004 at the original path.
;;
;; The reusable implementation is in the vendored file-replace.glon:
;;   file/replace-first path old new success failure
;; It opens the source read-only, writes a unique same-directory temporary,
;; streams the first-occurrence replacement, and only renames the temporary over
;; the original after every read/write/close succeeds.  On failure the original
;; path is not replaced and the temporary is removed where possible.
;;
;; This application is deliberately definitions-only; the challenge runner
;; appends the case call.  `cookbook/replace-first` is the Cookbook application.
cookbook/replace-first: func [] [
    file/replace-first "doc.txt" "web" "rebol"
        func [done] [ s/print "COOKBOOK_DONE" ]
        func [error] [ raise error ]
]
